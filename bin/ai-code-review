#!/usr/bin/env ruby
# frozen_string_literal: true

require 'dotenv/load'
require 'optparse'
require_relative '../lib/ai_code_review'

# 捕捉 Ctrl+C
trap('SIGINT') do
  puts "\n👋 收到停止指令，正在退出..."
  exit!
end

options = {
  dry_run: false,
  platform: 'github',
  skip_ai: false, # 默认不跳过
  full_review: false
}

# 1. 解析命令行参数
OptionParser.new do |opts|
  opts.banner = '🚀 用法: ai-code-review [options]'
  opts.on('-f', '--full', '进行全量评审，而不仅仅是 diff 改动行') { options[:full_review] = true }
  opts.on('-r', '--repo REPO', 'GitHub/GitLab 仓库名') { |v| options[:repo] = v }
  opts.on('-p', '--pr PR', 'PR/MR 编号') { |v| options[:pr] = v }
  opts.on('-d', '--dry-run', '强制进入干跑模式') { options[:dry_run] = true }
  opts.on('--platform PLAT', '平台 (github/gitlab)') { |v| options[:platform] = v.downcase }
  opts.on('--skip-ai', '只运行静态代码分析 (RuboCop)，不调用 AI') { options[:skip_ai] = true }
  opts.on('-h', '--help') do
    puts opts
    exit
  end
end.parse!

# 2. 智能合并参数与环境变量
repo      = options[:repo] || ENV['GITHUB_REPOSITORY'] || ENV['CI_PROJECT_PATH']
pr_number = options[:pr]   || ENV['GITHUB_PR_NUMBER'] || ENV['CI_MERGE_REQUEST_IID']
platform  = options[:platform]

# 3. 自动模式判定核心逻辑
# 如果没有 repo 或 pr_number，自动等同于 dry_run，并给用户一个提示
is_dry_run = options[:dry_run]

if repo.nil? || pr_number.nil?
  is_dry_run = true
  puts '💡 提示: 未检测到有效的仓库名或 PR 编号，已自动切换到 [Dry Run] 预览模式。'
  puts '   (如需同步到 GitHub，请提供 --repo 和 --pr 参数或设置环境变量)'
  puts '-' * 60
end

# 4. 启动程序
begin
  AiCodeReview.start(
    project_root: '.', # <--- 加上这个标签
    full_review: options[:full_review], # 别忘了把这个也传进去，否则 -f 参数会失效
    repo: repo,
    pr_number: pr_number,
    dry_run: is_dry_run,
    platform: platform,
    skip_ai: options[:skip_ai]
  )
rescue StandardError => e
  puts '💥 程序运行出错:'
  puts "信息: #{e.message}"
  # 调试时可以取消下面一行的注释查看完整堆栈
  # puts e.backtrace.join("\n")
  exit 1
end
